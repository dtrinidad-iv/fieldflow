{
  "name": "fieldflow",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless extensions and widgets for a low-code field-service app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "sam build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": ".claude/skills/verify/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
