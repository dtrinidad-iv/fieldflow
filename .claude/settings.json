{
  "permissions": {
    "allow": [
      "Bash(.claude/skills/verify/verify.sh)",
      "Bash(.claude/skills/verify/verify.sh *)",
      "Bash(scripts/scan-secrets.sh)",
      "Bash(scripts/scan-secrets.sh *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run verify)",
      "Bash(sam validate *)",
      "Bash(sam build)",
      "Bash(sam build *)"
    ],
    "ask": [
      "Bash(sam deploy *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.envrc)",
      "Read(./env.json)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(sam delete *)",
      "Bash(sam sync)",
      "Bash(sam sync *)",
      "Bash(sam remote *)",
      "Bash(aws cloudformation delete-stack *)",
      "Bash(aws cloudformation execute-change-set *)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 rb *)",
      "Bash(aws dynamodb delete-table *)",
      "Bash(aws secretsmanager get-secret-value *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.py" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
