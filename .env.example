# Copy to .env for local runs against the live app. Never commit .env.
# Tests ignore these and use the in-memory adapter.

# Tadabase API keys (Settings → API Keys in the app builder)
TADABASE_APP_ID=
TADABASE_APP_KEY=
TADABASE_APP_SECRET=

# Timeout for each Tadabase API request, in milliseconds (100-8000, default 5000)
TADABASE_TIMEOUT_MS=5000

# Shared secret the app sends in the X-FieldFlow-Secret header on outgoing webhooks
WEBHOOK_SECRET=

# Set to 1 only in the deployed stack. The Tadabase adapter refuses writes without it.
FIELDFLOW_ALLOW_LIVE_WRITES=
