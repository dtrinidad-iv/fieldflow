# Copy to .env for local runs against the live app. Never commit .env.
# Tests ignore these and use the in-memory adapter.

# The dev app's READ-ONLY API key ("fieldflow-check", Settings → API Keys), for the read-only
# check: node --env-file=.env scripts/tadabase-check.js dev. The read/write key goes only into
# SSM for the deployed functions (docs/tadabase-setup.md, step 4).
TADABASE_APP_ID=
TADABASE_APP_KEY=
TADABASE_APP_SECRET=

# Timeout for each Tadabase API request, in milliseconds (100-8000, default 5000)
TADABASE_TIMEOUT_MS=5000

# Shared secret the app sends in the X-FieldFlow-Secret header on outgoing webhooks
WEBHOOK_SECRET=

# Set only by the deployed stack (AllowLiveWrites in samconfig.toml). Leave it empty here: the
# Tadabase adapter refuses writes without it.
FIELDFLOW_ALLOW_LIVE_WRITES=
